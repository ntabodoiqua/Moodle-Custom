<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ielts/db" VERSION="20231218" COMMENT="XMLDB file for local/ielts plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_ielts_exams" COMMENT="Stores IELTS exam data including full JSON content">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Name of the exam"/>
        <FIELD NAME="content_json" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Full JSON object consistent with ExamData interface"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when the exam was created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when the exam was last modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="name" UNIQUE="false" FIELDS="name"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ielts_attempts" COMMENT="Stores user exam attempts and submissions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="examid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to local_ielts_exams"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to user table"/>
        <FIELD NAME="score_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON containing user answers and scores"/>
        <FIELD NAME="final_band" TYPE="number" LENGTH="4" DECIMALS="1" NOTNULL="false" SEQUENCE="false" COMMENT="Final IELTS band score (e.g., 6.5)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when the attempt was created"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when the attempt was finished"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="examid" TYPE="foreign" FIELDS="examid" REFTABLE="local_ielts_exams" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="examid_userid" UNIQUE="false" FIELDS="examid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
