<!-- database init -->
<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/ielts/db" VERSION="20260125" COMMENT="XMLDB file for mod_ielts activity module"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="ielts" COMMENT="Main table storing IELTS activity instances (one per course module)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key to course table"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Name of the IELTS activity"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Activity description/introduction"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Format of the intro field (MOODLE, HTML, PLAIN, MARKDOWN)"/>
        <FIELD NAME="content_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Full JSON object containing exam data (ExamData interface)"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="9" SEQUENCE="false" COMMENT="Maximum grade (IELTS band scale 0-9)"/>
        <FIELD NAME="maxattempts" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Maximum number of attempts allowed (0 = unlimited)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when the activity was created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when the activity was last modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="name" UNIQUE="false" FIELDS="name"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="ielts_attempts" COMMENT="Stores user exam attempts and submissions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ieltsid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to ielts table (activity instance)"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to user table"/>
        <FIELD NAME="score_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON containing user answers and detailed scores"/>
        <FIELD NAME="final_band" TYPE="number" LENGTH="4" DECIMALS="1" NOTNULL="false" SEQUENCE="false" COMMENT="Final IELTS band score (e.g., 6.5)"/>
        <FIELD NAME="reading_band" TYPE="number" LENGTH="4" DECIMALS="1" NOTNULL="false" SEQUENCE="false" COMMENT="Reading band score"/>
        <FIELD NAME="listening_band" TYPE="number" LENGTH="4" DECIMALS="1" NOTNULL="false" SEQUENCE="false" COMMENT="Listening band score"/>
        <FIELD NAME="writing_band" TYPE="number" LENGTH="4" DECIMALS="1" NOTNULL="false" SEQUENCE="false" COMMENT="Writing band score (teacher graded)"/>
        <FIELD NAME="speaking_band" TYPE="number" LENGTH="4" DECIMALS="1" NOTNULL="false" SEQUENCE="false" COMMENT="Speaking band score (teacher graded)"/>
        <FIELD NAME="writing_feedback" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher feedback for writing"/>
        <FIELD NAME="speaking_feedback" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher feedback for speaking"/>
        <FIELD NAME="graded_by" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User ID of the teacher who graded"/>
        <FIELD NAME="timegraded" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when manually graded"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp when the attempt was started"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when the attempt was completed"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ieltsid" TYPE="foreign" FIELDS="ieltsid" REFTABLE="ielts" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="graded_by" TYPE="foreign" FIELDS="graded_by" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ieltsid_userid" UNIQUE="false" FIELDS="ieltsid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
